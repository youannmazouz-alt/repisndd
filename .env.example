# Robinhood Chain (EVM Layer 2, Arbitrum Orbit). Native gas token: ETH.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Defaults to <EXPLORER_URL>/api (Blockscout) when omitted.
NEXT_PUBLIC_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api

# Treasury EOA (0x...) that receives forecast commitments. Required.
NEXT_PUBLIC_INFER_TREASURY=

# Native token used as the commitment asset.
NEXT_PUBLIC_TOKEN_SYMBOL=ETH
NEXT_PUBLIC_INFER_DECIMALS=18
# Cost of a single forecast, in the native token (ETH).
NEXT_PUBLIC_FORECAST_COST=0.001

# Optional: enables the WalletConnect connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
